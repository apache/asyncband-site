{
	"name": "asyncband-site",
	"version": "0.0.0",
	"private": true,
	"description": "The website for Apache Asyncband (Incubating)",
	"homepage": "https://asyncband.apache.org/",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/apache/asyncband-site.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pagefind --site build --glob \"{docs,downloads}/**/*.html\"",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --deny-warnings && oxfmt --check .",
		"format": "oxfmt .",
		"validate": "pnpm check && pnpm lint && pnpm build"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"highlight.js": "^11.12.0",
		"mdsvex": "^0.12.8",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"pagefind": "^1.5.2",
		"sirv": "^3.0.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.23.0"
}
